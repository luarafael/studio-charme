# Somente valores públicos. Tudo com prefixo VITE_ entra no bundle do navegador.
# Nunca coloque DATABASE_URL, SESSION_SECRET ou credenciais neste arquivo.

# Só o desenvolvimento local. No site publicado o navegador chama /api no
# próprio domínio; a Vercel encaminha para o Railway (cookie first-party no iPhone).
VITE_API_URL=http://localhost:3333
# URL canônica do site (sitemap e robots). Em produção: https://seu-projeto.vercel.app
VITE_SITE_URL=http://localhost:5173
