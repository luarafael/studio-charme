# ---------------------------------------------------------------------------
# Studio Charme - exemplo de variáveis de ambiente
#
# Copie este arquivo para apps/api/.env e apps/web/.env.local e preencha os
# valores. NUNCA comite os arquivos .env preenchidos.
#
# Gere segredos aleatórios com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------


# ======================= apps/api/.env =====================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=debug

# PostgreSQL gerenciado no Neon. Use a connection string com pooler e SSL.
# Formato: postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://usuario:senha@localhost:5432/studio_charme?schema=public

# Necessário para as migrations do Prisma quando o Neon usa pooler:
# aponte para a connection string direta (sem "-pooler").
DIRECT_DATABASE_URL=postgresql://usuario:senha@localhost:5432/studio_charme?schema=public

# Origens do frontend autorizadas no CORS. Separadas por vírgula, sem curinga.
WEB_ORIGINS=http://localhost:5173
# URL pública do site, usada nos links de convite e recuperação de senha.
WEB_PUBLIC_URL=http://localhost:5173

# Segredo da sessão: mínimo de 32 caracteres aleatórios. Trocar invalida sessões.
SESSION_SECRET=troque-por-um-valor-aleatorio-de-no-minimo-32-caracteres
SESSION_COOKIE_NAME=sc_session
SESSION_TTL_HOURS=168
# Deixe vazio para restringir o cookie ao host da API.
COOKIE_DOMAIN=
# Em desenvolvimento sem HTTPS use false. Em produção é obrigatoriamente true.
COOKIE_SECURE=false

# Documentação OpenAPI. Precisa ser false em produção.
ENABLE_API_DOCS=true

# E-mail de convite e recuperação de senha.
# console = imprime o link no log e não envia mensagem real (use em desenvolvimento).
MAIL_PROVIDER=console
MAIL_FROM=Studio Charme <nao-responda@exemplo.com>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Armazenamento de imagens e comprovantes compatível com S3 (R2, Backblaze, MinIO...).
STORAGE_DRIVER=disabled
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=


# ======================= apps/web/.env.local ===============================
# Somente valores públicos. Nunca coloque DATABASE_URL ou segredos aqui:
# tudo com prefixo VITE_ vai para o bundle do navegador.

VITE_API_URL=http://localhost:3333
